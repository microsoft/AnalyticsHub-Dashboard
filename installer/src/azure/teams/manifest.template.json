{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "{{version}}",
  "id": "{{appId}}",
  "developer": {
    "name": "Microsoft",
    "websiteUrl": "https://github.com/microsoft/AnalyticsHub-Dashboard",
    "privacyUrl": "https://privacy.microsoft.com/privacystatement",
    "termsOfUseUrl": "https://www.microsoft.com/legal/terms-of-use"
  },
  "name": { "short": "DataHub App", "full": "DataHub App" },
  "description": {
    "short": "DataHub App insights for Microsoft Copilot, agents and Cowork.",
    "full": "DataHub App surfaces Microsoft 365 Copilot, agent and Cowork analytics in Teams, including estimated value and Cowork fit and readiness. Cowork credits and cost need optional credit consumption data."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#6264A7",
  "staticTabs": [{
    "entityId": "analytics-hub",
    "name": "DataHub App",
    "contentUrl": "https://{{fqdn}}/?host=teams",
    "websiteUrl": "https://{{fqdn}}/",
    "scopes": ["personal"]
  }],
  "configurableTabs": [{
    "configurationUrl": "https://{{fqdn}}/?host=teams&config=1",
    "canUpdateConfiguration": true,
    "scopes": ["team", "groupChat"]
  }],
  "validDomains": ["{{fqdn}}"],
  "webApplicationInfo": { "id": "{{clientId}}", "resource": "{{appIdUri}}" }
}

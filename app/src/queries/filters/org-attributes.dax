EVALUATE
SELECTCOLUMNS(
    SUMMARIZECOLUMNS(
        'Org Attribute Source'[Attribute],
        "Groups", COUNTROWS(
            TOPN(
                2,
                FILTER(
                    VALUES('Org Attribute Source'[Value]),
                    LEN(TRIM('Org Attribute Source'[Value])) > 0
                ),
                'Org Attribute Source'[Value], ASC
            )
        )
    ),
    "Column", 'Org Attribute Source'[Attribute],
    "Cardinality", [Groups]
)
ORDER BY [Column]

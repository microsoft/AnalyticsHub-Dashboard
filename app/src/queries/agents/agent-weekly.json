{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "calculate": "toDate(datum['Chat + Agent Interactions (Audit Logs)WeekStart'])",
      "as": "Week"
    }
  ],
  "encoding": {
    "x": {
      "field": "Week",
      "type": "temporal",
      "title": null,
      "axis": {
        "tickCount": { "interval": "week", "step": 1 },
        "labelExpr": "timeFormat(datum.value, '%-d %b')",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Agent Users",
      "type": "quantitative",
      "title": "People",
      "axis": { "labelExpr": "compactFormat(datum.value, '#,0')" }
    }
  },
  "layer": [
    {
      "mark": { "type": "area", "interpolate": "monotone", "opacity": 0.25 }
    },
    {
      "mark": { "type": "line", "interpolate": "monotone", "strokeWidth": 2 }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 40 },
      "encoding": {
        "tooltip": [
          { "field": "Week", "type": "temporal", "title": "Week starting", "format": "%d %b %Y" },
          { "field": "Agent Users", "type": "quantitative", "title": "People using agents", "format": ",.0f" },
          { "field": "Agent Sessions", "type": "quantitative", "title": "Agent sessions", "format": ",.0f" }
        ]
      }
    }
  ]
}